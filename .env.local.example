# Normalfall: `sh scripts/env-pull.sh` holt die Werte aus Vercel nach `.env.local` (gitignored).
# Diese Datei zeigt nur die Namen. Supabase-Werte stehen im Dashboard unter Project Settings -> API Keys.
# Achtung: `SUPABASE_SECRET_KEY` ist in Vercel als sensibel markiert; `vercel env pull` liefert dafür nur einen
# Platzhalter. Den echten Wert einmal von Hand eintragen, das Pull-Skript bewahrt ihn danach.

# Öffentlich (dürfen in den Client-Bundle):
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY>   # alter Name: NEXT_PUBLIC_SUPABASE_ANON_KEY (wird weiter akzeptiert)

# Öffentliche Basis-URL des Portals (für Links in Mails). Ohne Angabe wird der
# Host der Anfrage benutzt, lokal also http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://portal.chef-treff.de

# GEHEIM — nur serverseitig (Admin/Migration), niemals committen oder an den Client:
SUPABASE_SECRET_KEY=<SECRET_KEY>   # alter Name: SUPABASE_SERVICE_ROLE_KEY (wird weiter akzeptiert)

# Vercel Cron (/api/cron/mail): Vercel schickt den Wert als Bearer-Token; erzeugen mit `openssl rand -hex 32`
CRON_SECRET=<openssl rand -hex 32>

# Content-Security-Policy: bis hier `true` steht, läuft sie als Report-Only (Verstöße in den Vercel-Logs unter [csp]); danach scharf.
CSP_ENFORCE=false

# --- Integrationen (nur serverseitig; echte Werte NUR in .env.local / Vercel-Env, nie im Chat, Repo oder Drive) ---
# Neue Werte: `sh scripts/env-set.sh NAME` (setzt Vercel + .env.local in einem Schritt; sensible Vercel-Werte liefert env-pull nur als Platzhalter)
SWAPCARD_API_KEY=<swapcard-api-key>
SWAPCARD_EVENT_ID=<swapcard-event-id-fls27>   # nur für scripts/swapcard-probe.mjs; der Sync liest event.swapcard_event_id (set_edition_swapcard)
VIVENU_API_KEY=<vivenu-api-key>
VIVENU_WEBHOOK_SECRET=<vivenu-webhook-hmac-secret>
VIVENU_SANDBOX=true
# Ticketshop des Verkaeufers (Dashboard, nicht ueber die API abfragbar) — traegt den Undershop-Link
VIVENU_SHOP_BASE=https://<verkaeufer>.vivenushop.dev
HUBSPOT_ACCESS_TOKEN=<hubspot-service-key>   # Service-Schlüssel (Settings → Integrationen → Service-Schlüssel); Scopes siehe docs/zugangs-liste.md
HUBSPOT_CLIENT_SECRET=<optional>   # nur mit Projekt-App + Webhook (/api/webhooks/hubspot); Service-Schlüssel haben keine Webhooks, der Sweep läuft alle 15 Min.
SLACK_ONBOARDING_WEBHOOK_URL=<https://hooks.slack.com/services/…>   # Incoming Webhook des Kanals #fls27-onboarding (Gate-Fehler); bevorzugt
MAKE_ONBOARDING_WEBHOOK_URL=<https://hook.eu2.make.com/…>   # Alternative: make.com als reiner Transport nach Slack
SEVDESK_API_TOKEN=<sevdesk-api-token>
SEVDESK_CONTACT_PERSON_ID=<sevuser-id, optional>   # Ansprechpartner auf Shop-Rechnungsentwürfen; sonst erster SevUser
SEVDESK_COST_CENTRE_ID=<costcentre-id, optional>    # Kostenstelle FLS27 für Shop-Rechnungsentwürfe
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=noreply@chef-treff.de
ACTIVECAMPAIGN_API_URL=<https://<account>.api-us1.com>
ACTIVECAMPAIGN_API_KEY=<activecampaign-api-key>
SANITY_PROJECT_ID=<sanity-project-id>
SANITY_DATASET=production   # Dataset der Website; das Portal schreibt nur Dokumente vom Typ portalPartnerLogo (docs/runbooks/sanity-partner-logos.md)
SANITY_API_TOKEN=<sanity-token>   # bis zur Freigabe durch das Web-Team Rolle Viewer, für den Schreiblauf Editor (docs/zugangs-liste.md)
LUMA_API_KEY=<luma-api-key>
MAKE_WEBHOOK_SECRET=<openssl rand -hex 32>
ANTHROPIC_API_KEY=<anthropic-api-key>
SENTRY_DSN=<monitoring-dsn>
QONTO_INBOX_EMAIL=<rechnungseingang@…>
