# Kopiere diese Datei nach `.env.local` und trage die Werte aus dem
# Supabase-Dashboard ein (Project Settings -> API). `.env.local` ist gitignored.

# Öffentlich (dürfen in den Client-Bundle):
# Supabase hat die Schlüssel umbenannt: publishable ersetzt anon, secret ersetzt
# service_role. Der Code liest neu vor alt, `vercel env pull` liefert die neuen.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Öffentliche Basis-URL des Portals (für Links in Mails). Ohne Angabe wird der
# Host der Anfrage benutzt, lokal also http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://portal.chef-treff.de

# GEHEIM — nur serverseitig (Admin/Migration), niemals committen oder an den Client:
SUPABASE_SECRET_KEY=sb_secret_<...>

# --- Integrationen (nur serverseitig; echte Werte NUR in .env.local / Vercel-Env, nie im Chat, Repo oder Drive) ---
SWAPCARD_API_KEY=<swapcard-api-key>
SWAPCARD_EVENT_ID=<swapcard-event-id-fls27>
VIVENU_API_KEY=<vivenu-api-key>
VIVENU_WEBHOOK_SECRET=<vivenu-webhook-hmac-secret>
VIVENU_SANDBOX=true
HUBSPOT_ACCESS_TOKEN=<hubspot-private-app-token>
SEVDESK_API_TOKEN=<sevdesk-api-token>
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=noreply@chef-treff.de
ACTIVECAMPAIGN_API_URL=<https://<account>.api-us1.com>
ACTIVECAMPAIGN_API_KEY=<activecampaign-api-key>
SANITY_PROJECT_ID=<sanity-project-id>
SANITY_DATASET=production
SANITY_API_TOKEN=<sanity-editor-token>
LUMA_API_KEY=<luma-api-key>
MAKE_WEBHOOK_SECRET=<openssl rand -hex 32>
ANTHROPIC_API_KEY=<anthropic-api-key>
SENTRY_DSN=<monitoring-dsn>
QONTO_INBOX_EMAIL=<rechnungseingang@…>
